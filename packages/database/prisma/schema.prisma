generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MeetingStatus {
  UPLOADED
  QUEUED
  PREPROCESSING
  TRANSCRIBING
  ANALYZING
  COMPLETED
  FAILED
}

enum ProcessingJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ActionItemPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ActionItemStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
}

model Meeting {
  id            String           @id @default(uuid()) @db.Uuid
  title         String
  audioPath     String?
  audioFileName String?
  audioMimeType String?
  fileSize      Int?
  duration      Float?
  language      String?
  status        MeetingStatus    @default(UPLOADED)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  processingJob ProcessingJob?
  transcript    Transcript?
  speakers      MeetingSpeaker[]
  summary       MeetingSummary?
  decisions     Decision[]
  actionItems   ActionItem[]
}

model ProcessingJob {
  id           String              @id @default(uuid()) @db.Uuid
  meetingId    String              @unique @db.Uuid
  status       ProcessingJobStatus @default(PENDING)
  progress     Int                 @default(0)
  currentStage String?
  error        String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  meeting      Meeting             @relation(fields: [meetingId], references: [id], onDelete: Cascade)
}

model Transcript {
  id        String              @id @default(uuid()) @db.Uuid
  meetingId String              @unique @db.Uuid
  fullText  String
  language  String?
  duration  Float?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  meeting   Meeting             @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  segments  TranscriptSegment[]
}

model MeetingSpeaker {
  id                 String              @id @default(uuid()) @db.Uuid
  meetingId          String              @db.Uuid
  providerSpeakerId  Int
  label              String
  name               String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  meeting            Meeting             @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  transcriptSegments TranscriptSegment[]

  @@unique([meetingId, providerSpeakerId])
  @@index([meetingId])
}

model TranscriptSegment {
  id                String          @id @default(uuid()) @db.Uuid
  transcriptId      String          @db.Uuid
  speakerId         String?         @db.Uuid
  startTime         Float
  endTime           Float
  text              String
  confidence        Float?
  createdAt         DateTime        @default(now())
  transcript        Transcript      @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  speaker           MeetingSpeaker? @relation(fields: [speakerId], references: [id], onDelete: SetNull)
  sourceDecisions   Decision[]      @relation("DecisionSourceSegment")
  sourceActionItems ActionItem[]    @relation("ActionItemSourceSegment")

  @@index([transcriptId])
  @@index([transcriptId, startTime])
  @@index([speakerId])
}

model MeetingSummary {
  id               String   @id @default(uuid()) @db.Uuid
  meetingId        String   @unique @db.Uuid
  overview         String
  keyTopics        Json
  outcomes         Json
  unresolvedIssues Json
  model            String
  promptVersion    String
  generatedAt      DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
}

model Decision {
  id              String   @id @default(uuid()) @db.Uuid
  meetingId       String   @db.Uuid
  decision        String
  context         String?
  evidence        String
  sourceStartTime Float?
  sourceSegmentId String?  @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  meeting       Meeting            @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  sourceSegment TranscriptSegment? @relation("DecisionSourceSegment", fields: [sourceSegmentId], references: [id], onDelete: SetNull)

  @@index([meetingId])
  @@index([meetingId, sourceStartTime])
  @@index([sourceSegmentId])
}

model ActionItem {
  id              String             @id @default(uuid()) @db.Uuid
  meetingId       String             @db.Uuid
  task            String
  owner           String?
  dueDate         String?
  priority        ActionItemPriority
  status          ActionItemStatus   @default(OPEN)
  evidence        String
  sourceStartTime Float?
  sourceSegmentId String?            @db.Uuid
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  meeting       Meeting            @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  sourceSegment TranscriptSegment? @relation("ActionItemSourceSegment", fields: [sourceSegmentId], references: [id], onDelete: SetNull)

  @@index([meetingId])
  @@index([meetingId, status])
  @@index([meetingId, priority])
  @@index([sourceSegmentId])
}
