DATABASE_URL=

API_PORT=3001
WEB_PORT=3000
FRONTEND_URL=http://localhost:3000
# Set to the number of trusted reverse proxies in production (commonly 1).
TRUST_PROXY=0
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional PEM public key for networkless session-token verification:
CLERK_JWT_KEY=
CLERK_WEBHOOK_SECRET=

REDIS_HOST=localhost
REDIS_PORT=6379
# Optional alternative to REDIS_HOST and REDIS_PORT:
# REDIS_URL=redis://localhost:6379

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AUDIO_BUCKET=meeting-audio
# Preferred production name; SUPABASE_AUDIO_BUCKET remains supported for compatibility.
SUPABASE_STORAGE_BUCKET=meeting-audio
SUPABASE_TIMEOUT_MS=15000
MAX_AUDIO_FILE_SIZE_MB=50
ABANDONED_UPLOAD_MAX_AGE_HOURS=24

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public Notion connection. Register this exact callback in the Notion developer portal.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:3001/api/v1/integrations/notion/oauth/callback
# Base64-encoded 32-byte key used only to encrypt stored OAuth tokens.
NOTION_TOKEN_ENCRYPTION_KEY=
NOTION_TIMEOUT_MS=15000

DEEPGRAM_API_KEY=
DEEPGRAM_TRANSCRIPTION_MODEL=whisper
DEEPGRAM_DIARIZATION_MODEL=latest
DEEPGRAM_TIMEOUT_MS=600000
DEEPGRAM_NETWORK_RETRY_DELAY_MS=1000
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MAX_TRANSCRIPT_TOKENS=100000
DEEPSEEK_TIMEOUT_MS=120000

# Optional LangSmith tracing for AI-provider calls.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=meeting-intelligence-development
# Set this only when your LangSmith workspace is outside the default US region.
# LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com
# Required only when the API key can access multiple workspaces.
# LANGSMITH_WORKSPACE_ID=

MEETING_WORKER_CONCURRENCY=2
MAX_ACTIVE_MEETINGS_PER_USER=3
MEETING_JOB_ATTEMPTS=3
MEETING_JOB_BACKOFF_MS=2000
API_RATE_LIMIT=120
API_RATE_TTL_MS=60000
